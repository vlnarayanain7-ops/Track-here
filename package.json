{
  "name": "track-here",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "postinstall": "npm --prefix client install --include=dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build && node -e \"require('fs').cpSync('client/dist', 'dist', {recursive: true})\"",
    "start": "npm --prefix server start",
    "test:audit": "node tests/test-audit.mjs",
    "test:production-audit": "node tests/production-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.5"
  }
}
