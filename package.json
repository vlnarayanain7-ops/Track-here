{
  "name": "track-here",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "postinstall": "npm --prefix client install --include=dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build && node -e \"require('fs').cpSync('client/dist', 'dist', {recursive: true}); try { require('fs').unlinkSync('dist/_redirects'); } catch(e){}\"",
    "start": "npm --prefix server start",
    "migrate:sessions:dry": "node server/scripts/migrate-session-durations.mjs",
    "test:pomodoro": "node --test client/src/lib/pomodoro.test.js",
    "test:sessions": "node --test client/src/lib/sessions.test.js",
    "test:history": "node --test client/src/lib/history.test.js",
    "test:unit": "node --test client/src/lib/*.test.js",
    "test:server": "node --test server/services/*.test.js server/models/*.test.js",
    "test:e2e": "node scripts/launch-browser-check.mjs",
    "test:localhost": "node scripts/localhost-browser-check.mjs",
    "check:launch": "node scripts/check-launch.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.5"
  }
}
