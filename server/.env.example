# server/.env.example (copy to server/.env, never commit the real one)
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trackhere?retryWrites=true&w=majority
MONGODB_URI_TEST=
JWT_ACCESS_SECRET=replace-with-48-random-bytes-hex
JWT_REFRESH_SECRET=replace-with-48-random-bytes-hex
CLIENT_URL=https://track-here.beta-001.workers.dev
COOKIE_DOMAIN=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
DISABLE_RATE_LIMIT=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@trackhere.dev
# generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Comma-separated MongoDB user IDs of approved administrators
ADMIN_USER_IDS=
CERT_SECRET=
