# server/.env.example (copy to server/.env, never commit the real one)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trackhere
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/trackhere_test
JWT_ACCESS_SECRET=replace-with-48-random-bytes-hex
JWT_REFRESH_SECRET=replace-with-48-random-bytes-hex
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
DISABLE_RATE_LIMIT=false
# generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
